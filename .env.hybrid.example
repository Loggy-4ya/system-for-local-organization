# =============================================================================
# Nexus — Hybrid deployment profile
# =============================================================================
#
# Web app on Vercel (or serverless) + always-on worker for MTProto / Telegram.
#
# 1. Set the variables below on Vercel (web app).
# 2. Run telegram-worker (Phase 4b) on VPS/Railway/Fly with TELEGRAM_OPERATOR_SESSION.
# Full variable reference: `.env.example`
#
# See also: `.ai/docs/features/hosting_and_deployment.md`
#           `.ai/docs/features/telegram_project_workspaces.md`
# =============================================================================

NEXUS_HOSTING_MODE=hybrid

# ── Web app (Vercel / serverless) ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexus
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://your-domain.example

CRON_SECRET=generate-a-random-secret-here

MEDIA_STORAGE_DRIVER=gcs
GCS_MEDIA_BUCKET=your-nexus-media-bucket

TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: GramJS string session for telegram-worker auto-create (NOT on Vercel web app).
# Worker also needs TELEGRAM_API_ID + TELEGRAM_API_HASH from https://my.telegram.org
# TELEGRAM_OPERATOR_SESSION=gramjs-exported-session-string
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_WORKER_POLL_SECONDS=15

ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here
