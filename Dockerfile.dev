# Development Dockerfile — hot-reload via volume mount
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Ensure dependencies exist, then start dev server
CMD ["sh", "-c", "if [ ! -d \"node_modules\" ]; then npm ci; fi && npm run dev"]
