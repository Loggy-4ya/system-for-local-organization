# Development Dockerfile — hot-reload via volume mount
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Reinstall when lockfile changes, core packages are missing, or install is incomplete.
CMD ["sh", "-c", "if [ ! -f node_modules/.bin/next ] || [ ! -d node_modules/vaul ] || [ ! -d node_modules/@puckeditor/core ] || [ package-lock.json -nt node_modules/.install-stamp ]; then npm ci && touch node_modules/.install-stamp; fi && npm run dev"]
