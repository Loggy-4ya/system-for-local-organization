# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexus

# Auth.js — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
# Desktop: http://localhost:8080
# Phone on same Wi‑Fi: http://YOUR_LAN_IP:8080  (run: hostname -I | awk '{print $1}')
NEXTAUTH_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Telegram Login Widget (BotFather token + public bot username)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Admin seed user
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=