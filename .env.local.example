# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexus

# Auth.js — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
# Must match the URL in your browser (scheme + host + port).
# Desktop: http://localhost:8080
# Phone on same Wi‑Fi: use your PC's LAN IP — NOT localhost (on the phone, localhost is the phone).
#   hostname -I | awk '{print $1}'  →  e.g. NEXTAUTH_URL=http://192.168.1.42:8080
NEXTAUTH_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Telegram Login Widget + Mini App + Bot webhook (BotFather token + public bot username)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Optional — validate Telegram webhook via X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
# Mini App URL defaults to ${NEXTAUTH_URL}/telegram — set in BotFather Web App settings

# Admin seed user — sign in with ADMIN_SEED_LOGIN + ADMIN_SEED_PASSWORD (not email).
# ADMIN_SEED_EMAIL is optional; stored as linked contact only, not used for sign-in.
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=your_secure_password_here

# Media storage — local filesystem (default) or Google Cloud Storage when deployed
MEDIA_STORAGE_DRIVER=local
# GCS_MEDIA_BUCKET=
# GCS_MEDIA_PUBLIC_BASE_URL=