# =============================================================================
# Nexus — AWS S3 media storage profile
# =============================================================================
#
# Use when Nexus runs with Amazon S3 as the media backend:
#   • AWS ECS / EC2 / Lambda
#   • VPS on AWS with external MongoDB
#   • Vercel (set the same vars in project Environment Variables)
#
# Merge with a hosting profile — this file only covers object storage vars.
# For a full VPS stack, start from `.env.vps-external-db.example` and replace
# the MEDIA_STORAGE_* block with the lines below.
#
# Full variable reference: `.env.example`
# Deploy guide: `.ai/docs/features/hosting_and_deployment.md#media-storage-at-deploy-time`
# =============================================================================

# ── S3 media (required in production on serverless / hybrid) ─────────────────
MEDIA_STORAGE_DRIVER=s3
S3_MEDIA_BUCKET=your-nexus-media-bucket
S3_MEDIA_REGION=eu-central-1

# Optional — CloudFront or custom CDN origin for browser-facing media URLs.
# When set, uploads return URLs under this base instead of the raw S3 hostname.
# S3_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media

MEDIA_ORPHAN_MIN_AGE_HOURS=24

# ── AWS credentials ──────────────────────────────────────────────────────────
# On ECS/EC2/Lambda: prefer an IAM task/instance role (omit these keys).
# On Vercel or hosts without IAM roles: create an IAM user with s3:PutObject,
# s3:DeleteObject, and s3:ListBucket on the media bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
