{$NEXTAUTH_URL} {
	encode zstd gzip

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 15s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
