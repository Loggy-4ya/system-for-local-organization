# =============================================================================
# Nexus — team shared env (plaintext template for dotenvx)
# =============================================================================
#
# Purpose:
#   Starting point for `.env.staging` — the encrypted file teammates pull from git.
#   This is NOT the runtime file. Docker and Next.js always read `.env.local`.
#
# Naming note:
#   "staging" means shared pre-production team environment (Atlas staging cluster,
#   staging HTTPS URL, shared OAuth apps) — NOT git's staging area.
#
# ── Maintainer workflow ────────────────────────────────────────────────────────
#
#   cp .env.staging.plain.example .env.staging
#   # Fill real shared staging values (Atlas, OAuth, Telegram, admin seed, …)
#   npm run env:encrypt-team
#   git add .env.staging
#   git commit -m "Add encrypted team staging env"
#   # Store .env.keys in team vault (1Password, Bitwarden) — NEVER commit
#
# Faster path if you already have a filled .env.local:
#   npm run env:encrypt-local    # copies .env.local → .env.staging → encrypt
#
# ── Developer workflow ─────────────────────────────────────────────────────────
#
#   # Copy .env.keys from team vault into repo root
#   npm run env:pull-team        # decrypts .env.staging → writes .env.local
#   npm run docker:up:external   # or docker:up if using bundled MongoDB
#
# ── Production deploy ──────────────────────────────────────────────────────────
#
#   Do NOT use this file for production EC2 unless your team intentionally shares
#   one staging-tier env. Production should use separate values (prod Atlas DB,
#   prod NEXTAUTH_URL, S3 bucket, prod Telegram bot). See hosting_and_deployment.md.
#
# Full guide: .ai/docs/env_and_secrets.md
# Variable reference: .env.example (every supported key with extended comments)
# =============================================================================


# ── Hosting ────────────────────────────────────────────────────────────────────
# Always `vps` for Nexus. In-process scheduler on shared staging server.
NEXUS_HOSTING_MODE=vps


# ── Database ───────────────────────────────────────────────────────────────────
# Shared Atlas staging cluster. Whitelist office IPs + staging server IP in Atlas.
# Replace USER, PASS, and cluster hostname with your team values.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexus-staging?retryWrites=true&w=majority


# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Must match the public URL where the shared staging site is hosted.
NEXTAUTH_SECRET=replace-with-staging-secret
NEXTAUTH_URL=https://staging.example.com


# ── Background jobs ────────────────────────────────────────────────────────────
# Same defaults as local dev — in-process timers, no external crontab needed.
SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15
MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24


# ── Media ──────────────────────────────────────────────────────────────────────
# Use `local` for a staging server without S3, or `s3` with bucket vars from .env.example.
# If NODE_ENV=production on staging EC2, boot requires MEDIA_STORAGE_DRIVER=s3.
MEDIA_STORAGE_DRIVER=local


# ── Telegram ───────────────────────────────────────────────────────────────────
# Shared staging bot from @BotFather. Register webhook + Mini App URL against NEXTAUTH_URL.
# For auto project groups, also set TELEGRAM_OPERATOR_SESSION, TELEGRAM_API_ID,
# TELEGRAM_API_HASH (see .env.example — MTProto section).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=


# ── First admin (seed) ─────────────────────────────────────────────────────────
# Credentials for the initial system admin on a fresh staging database.
# Change from defaults before first deploy to the shared staging server.
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=replace-with-staging-password


# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Staging OAuth client — redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
