# =============================================================================
# Nexus — Serverless deployment profile (Vercel)
# =============================================================================
#
# Set these in the Vercel project → Settings → Environment Variables.
# Full variable reference (OAuth, optional features): `.env.example`
# Do NOT copy in-process scheduler vars (they are ignored / rejected in prod).
#
# See also: `.ai/docs/features/hosting_and_deployment.md`
# =============================================================================

NEXUS_HOSTING_MODE=serverless

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexus
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://your-domain.example

# Required in production — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-random-secret-here

# DO NOT SET on Vercel (use vercel.json crons instead):
# SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=
# MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=

# Object storage required — local uploads do not persist on serverless
# Use GCS on Vercel/GCP, or S3 on AWS (see .env.example for S3 vars)
MEDIA_STORAGE_DRIVER=gcs
GCS_MEDIA_BUCKET=your-nexus-media-bucket
# GCS_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media

MEDIA_ORPHAN_MIN_AGE_HOURS=24

# Telegram webhook → https://your-domain.example/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Do NOT put MTProto session on Vercel — use hybrid profile + separate worker
# TELEGRAM_OPERATOR_SESSION=

ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here

# OAuth (production redirect URIs must match NEXTAUTH_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
