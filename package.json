{
  "name": "nexus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "auth:check-env": "node scripts/auth/checkAuthEnv.mjs",
    "dev:tunnel": "node scripts/dev/tunnel/startDevTunnel.mjs",
    "dev:tunnel:sync": "node scripts/dev/tunnel/ngrokSyncEnv.mjs",
    "dev:tunnel:stop": "node scripts/dev/tunnel/stopDevTunnel.mjs",
    "dev:tunnel:setup": "node scripts/dev/tunnel/setupNgrokAuth.mjs",
    "dev:tunnel:doctor": "node scripts/dev/tunnel/ngrokDoctor.mjs",
    "env:init": "node scripts/env/envInit.mjs",
    "env:pull-team": "node scripts/env/envDotenvx.mjs pull",
    "env:encrypt-team": "node scripts/env/envDotenvx.mjs encrypt",
    "env:encrypt-local": "node scripts/env/envDotenvx.mjs encrypt-local",
    "env:run": "node scripts/env/envDotenvx.mjs run",
    "infra:synth": "cdk synth",
    "infra:diff": "cdk diff",
    "infra:deploy:identity": "cdk deploy NexusGithubIdentity",
    "infra:deploy:staging": "cdk deploy NexusStaging",
    "infra:deploy:production": "cdk deploy NexusProduction",
    "deploy:configure-github": "node scripts/deploy/configureGithubDeployment.mjs",
    "docker:up": "docker compose --profile dev --profile bundled-db up",
    "docker:up:external": "docker compose --profile dev up",
    "docker:up:prod": "docker compose --profile prod up --build",
    "test": "node scripts/test/runTests.mjs --all",
    "test:run": "node scripts/test/runTests.mjs",
    "test:list": "node scripts/test/runTests.mjs --list",
    "test:puck": "node scripts/test/runTests.mjs --group puck",
    "job:media-orphan-cleanup": "npx tsx scripts/jobs/mediaOrphanCleanup.ts",
    "job:media-orphan-cleanup:dry-run": "npx tsx scripts/jobs/mediaOrphanCleanup.ts --dry-run",
    "job:process-scheduled-events": "npx tsx scripts/jobs/processScheduledEvents.ts",
    "job:process-scheduled-events:dry-run": "npx tsx scripts/jobs/processScheduledEvents.ts --dry-run",
    "worker:telegram": "npx tsx scripts/workers/telegramWorker.ts",
    "job:remove-user-accent-fields": "npx tsx scripts/jobs/migrations/removeUserAccentFields.ts",
    "job:remove-user-accent-fields:dry-run": "npx tsx scripts/jobs/migrations/removeUserAccentFields.ts --dry-run",
    "job:fix-user-unique-indexes": "npx tsx scripts/jobs/migrations/fixUserUniqueIndexes.ts",
    "job:fix-user-unique-indexes:dry-run": "npx tsx scripts/jobs/migrations/fixUserUniqueIndexes.ts --dry-run",
    "job:migrate-global-layout-header": "npx tsx scripts/jobs/migrations/migrateGlobalLayoutHeader.ts",
    "job:migrate-global-layout-header:dry-run": "npx tsx scripts/jobs/migrations/migrateGlobalLayoutHeader.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@base-ui/react": "^1.5.0",
    "@puckeditor/core": "^0.21.3",
    "@teispace/next-themes": "^2.0.2",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/suggestion": "^3.26.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "mongoose": "^9.6.3",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.1.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.0.2",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "tsx": "^4.23.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "@playwright/test": "^1.51.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk": "^2.1131.0",
    "aws-cdk-lib": "^2.261.0",
    "cdk-nag": "^3.0.1",
    "constructs": "^10.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
