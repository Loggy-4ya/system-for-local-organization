# =============================================================================
# Nexus — VPS with external MongoDB
# =============================================================================
#
# Use when the app runs on a VPS (or Docker) but MongoDB is hosted elsewhere:
#   • MongoDB Atlas (recommended for production)
#   • A dedicated database VPS
#   • Managed MongoDB from your cloud provider
#
# Copy to `.env.local`:
#   cp .env.vps-external-db.example .env.local
#
# Docker (web container only — no bundled MongoDB):
#   docker compose up
#
# Bare-metal Node (after `npm run build`):
#   npm run start
#
# Full variable reference: `.env.example`
# See also: `.ai/docs/features/hosting_and_deployment.md`
# =============================================================================

NEXUS_HOSTING_MODE=vps

# External MongoDB — replace with your connection string.
# Atlas example (add your IP to Atlas Network Access allowlist):
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexus?retryWrites=true&w=majority
#
# Self-hosted MongoDB on another machine:
# MONGODB_URI=mongodb://dbuser:dbpass@10.0.0.5:27017/nexus?authSource=admin

NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://your-domain.example

# In-process background jobs (no HTTP cron required on VPS)
SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15
MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24

# Local disk uploads — mount a persistent volume in Docker/production
MEDIA_STORAGE_DRIVER=local
MEDIA_ORPHAN_MIN_AGE_HOURS=24

# Optional: GCS instead of local disk (if you prefer object storage on VPS too)
# MEDIA_STORAGE_DRIVER=gcs
# GCS_MEDIA_BUCKET=your-nexus-media-bucket
# GCS_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media

# Optional: Amazon S3 instead of local disk (see .env.aws.example)
# MEDIA_STORAGE_DRIVER=s3
# S3_MEDIA_BUCKET=your-nexus-media-bucket
# S3_MEDIA_REGION=eu-central-1
# S3_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media

TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here
