# =============================================================================
# Nexus — VPS / Docker with bundled MongoDB (local dev)
# =============================================================================
#
# Copy to `.env.local`:
#   cp .env.vps.example .env.local
#
# Start app + MongoDB container together:
#   docker compose -f docker-compose.yml -f docker-compose.bundled-db.yml --profile bundled-db up
#
# For VPS + external MongoDB (Atlas, dedicated DB host), use instead:
#   cp .env.vps-external-db.example .env.local
#   docker compose up
#
# Full variable reference: `.env.example`
# See also: `.ai/docs/features/hosting_and_deployment.md`
# =============================================================================

NEXUS_HOSTING_MODE=vps

MONGODB_URI=mongodb://db:27017/nexus
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:8080

# In-process background jobs (no HTTP cron required)
SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15
MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24

# Local disk uploads (fine on VPS with a persistent volume)
MEDIA_STORAGE_DRIVER=local
MEDIA_ORPHAN_MIN_AGE_HOURS=24

# Optional: external crontab instead of in-process tick — set secret and leave
# SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS unset:
# NEXUS_CRON_SECRET=generate-a-random-secret-here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Apple Sign In (optional) — npm run auth:apple-secret
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Optional: GramJS / Telethon string session for auto-creating project groups (telegram-worker).
# Also required on the worker host: TELEGRAM_API_ID, TELEGRAM_API_HASH (from my.telegram.org).
# TELEGRAM_OPERATOR_SESSION=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_WORKER_POLL_SECONDS=15

ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here
