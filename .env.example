# =============================================================================
# Nexus — environment reference (`.env.example`)
# =============================================================================
#
# This file is the committed catalogue of every supported environment variable.
# It contains NO real secrets — only placeholders, defaults, and documentation.
#
# ── How Nexus uses env files ───────────────────────────────────────────────
#
#   .env.example     →  You are here. Reference + template. Safe in git.
#   .env.local       →  Runtime file on your machine or EC2. NEVER commit.
#   .env.staging     →  Optional team-shared env, encrypted with dotenvx. Safe
#                       in git after encrypt (values look like encrypted:…).
#   .env.keys        →  dotenvx decryption key. NEVER commit — team vault only.
#
# ── First-time local setup ───────────────────────────────────────────────────
#
#   npm install
#   npm run env:init              # copies this file → .env.local (skips if exists)
#   # Edit .env.local with real secrets
#   npm run auth:check-env        # validate OAuth / Telegram config
#   npm run docker:up             # web + telegram-worker + bundled MongoDB
#
# ── Team shared secrets (dotenvx) ────────────────────────────────────────────
#
#   Maintainer:  npm run env:encrypt-local   # .env.local → .env.staging → encrypt
#                 git add .env.staging && commit
#                 Store .env.keys in 1Password / Bitwarden — never in git
#   Developer:   npm run env:pull-team       # decrypt .env.staging → .env.local
#
# ── Production (AWS EC2) ─────────────────────────────────────────────────────
#
#   Manual server: create .env.local manually OR env:pull-team.
#   GitHub CI/CD: store the complete dotenv payload in AWS Secrets Manager at
#     nexus/staging/runtime-env or nexus/production/runtime-env.
#   EC2 materializes /opt/nexus/.env.local through its instance role; GitHub
#   cannot read the runtime secret and stores no permanent AWS access key.
#   Minimum: Atlas MONGODB_URI, HTTPS NEXTAUTH_URL, MEDIA_STORAGE_DRIVER=s3,
#   stack-output S3 bucket/region, and environment-specific OAuth/Telegram vars.
#
#   Full deploy guide: .ai/docs/features/hosting_and_deployment.md
#   Secrets & dotenvx:  .ai/docs/env_and_secrets.md
#
# Docker Compose always loads `.env.local` via env_file: (web, web-prod, workers).
# =============================================================================


# ── Hosting mode ─────────────────────────────────────────────────────────────
#
# Nexus targets always-on deployment (AWS EC2 or local Docker). There is only one
# supported mode today: `vps` (in-process background jobs — no serverless split).
#
#   vps  — Default. Scheduled tasks and media orphan cleanup run inside the web
#          process via setInterval. telegram-worker runs as a separate container.
#
# Leave unset or set explicitly to `vps`. Other values cause boot validation errors.
#
NEXUS_HOSTING_MODE=vps

# Abort boot when hosting env is invalid.
#   • Production (NODE_ENV=production): invalid config always aborts boot.
#   • Development: abort only when NEXUS_HOSTING_STRICT=true.
# Use strict=true locally when testing production-like S3 / Atlas configuration.
#
# NEXUS_HOSTING_STRICT=true


# ── Database (MongoDB) ───────────────────────────────────────────────────────
#
# Required for every environment. Used by Next.js, background jobs, migrations,
# and telegram-worker. Connection must be reachable from all containers/processes.
#
# Typical values:
#
#   Bundled Docker Compose (db service):
#     mongodb://db:27017/nexus
#     Hostname `db` is the Compose service name — use this inside Docker.
#
#   MongoDB Atlas / remote cluster:
#     mongodb+srv://USER:PASS@cluster.mongodb.net/nexus?retryWrites=true&w=majority
#     Add your EC2 or dev machine IP to Atlas → Network Access.
#     Then: npm run docker:up:external  (no bundled db container)
#
#   Node on host without Docker:
#     mongodb://localhost:27017/nexus
#
MONGODB_URI=mongodb://db:27017/nexus


# ── Auth (NextAuth / Auth.js) ─────────────────────────────────────────────────
#
# NEXTAUTH_SECRET — Signs session cookies and JWTs. Required in all environments.
#   Generate a strong random value:
#     openssl rand -base64 32
#   Rotate on compromise; all users will need to sign in again.
#
NEXTAUTH_SECRET=generate-a-random-secret-here

# NEXTAUTH_URL — Public canonical URL of this Nexus site (scheme + host + port).
#   Must exactly match what users type in the browser bar. Used for:
#     • OAuth redirect URIs (${NEXTAUTH_URL}/api/auth/callback/google, etc.)
#     • Absolute links in emails, Telegram messages, and page publish notifications
#     • Telegram Mini App registration (${NEXTAUTH_URL}/telegram)
#
# Examples:
#   Desktop Docker dev:     http://localhost:8080
#   Phone on same Wi‑Fi:    http://192.168.1.42:8080  (your PC's LAN IP — NOT localhost)
#   ngrok OAuth testing:    https://your-name.ngrok-free.app  (via npm run dev:tunnel)
#   Production EC2:         https://nexus.example.com  (HTTPS required)
#
# Tip — find LAN IP:  hostname -I | awk '{print $1}'
#
NEXTAUTH_URL=http://localhost:8080

# AUTH_URL — Optional alias for NEXTAUTH_URL (Auth.js compatibility). Prefer NEXTAUTH_URL.
# AUTH_URL=

# NEXUS_DEV_ALLOWED_ORIGINS — Comma-separated extra hostnames for Next.js dev only.
#   Use when NEXTAUTH_URL points at ngrok (HTTPS) but you also browse via LAN IP
#   and need dev HMR/assets to load. Hostnames only — no scheme or port.
#   Example: 192.168.1.42,192.168.1.43
#   Ignored in production builds.
#
# NEXUS_DEV_ALLOWED_ORIGINS=192.168.1.42


# ── Google OAuth (optional) ────────────────────────────────────────────────────
#
# Enables "Sign in with Google" on /login. Both values required together.
#
# Setup:
#   1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
#   2. Authorized redirect URI:  ${NEXTAUTH_URL}/api/auth/callback/google
#   3. For local dev with ngrok, register the ngrok HTTPS URL (not LAN IP).
#
# See: .ai/docs/features/local_oauth_setup.md
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Telegram bot & Login Widget (optional) ─────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN — From @BotFather. Required for:
#   • Telegram Login Widget on /login
#   • Webhook handler (/api/telegram/webhook)
#   • Task notifications, broadcasts, Mini App auth
#   • telegram-worker (alongside operator session)
#
TELEGRAM_BOT_TOKEN=

# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME — Bot username without @. Exposed to the browser
#   for the Login Widget embed. Must match the bot tied to TELEGRAM_BOT_TOKEN.
#
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# TELEGRAM_WEBHOOK_SECRET — Optional. When set, Telegram sends this value in
#   X-Telegram-Bot-Api-Secret-Token on webhook POSTs; Nexus rejects mismatches.
#   Generate with: openssl rand -hex 32
#
# TELEGRAM_WEBHOOK_SECRET=

# ── Telegram MTProto operator (optional — auto project groups) ─────────────────
#
# Without these, project Telegram groups require manual /link by an admin.
# With full operator env, telegram-worker auto-creates groups and invites members.
#
# Required together for auto-create:
#   TELEGRAM_OPERATOR_SESSION  — GramJS StringSession (from npm run worker:telegram login)
#   TELEGRAM_API_ID            — From https://my.telegram.org → API development tools
#   TELEGRAM_API_HASH          — Same page as API ID
#   TELEGRAM_BOT_TOKEN         — Must also be set (see above)
#
# TELEGRAM_WORKER_POLL_SECONDS — How often worker polls for pending group jobs (default 15).
#
# Run worker locally:  npm run worker:telegram
# Docker dev/prod:     included in docker:up / docker:up:prod (telegram-worker service)
#
# See: .ai/docs/features/telegram_project_workspaces.md
#
# TELEGRAM_OPERATOR_SESSION=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_WORKER_POLL_SECONDS=15

# Mini App URL for BotFather → Web App settings:  ${NEXTAUTH_URL}/telegram


# ── ngrok tunnel (local OAuth + Telegram — dev only) ───────────────────────────
#
# Google OAuth rejects LAN IPs. Telegram Login Widget requires HTTPS.
# Use ngrok to expose localhost with a public HTTPS URL, then sync NEXTAUTH_URL.
#
# Workflow:
#   1. Add NGROK_AUTHTOKEN to .env.local (from https://dashboard.ngrok.com)
#   2. Optional: NGROK_STATIC_DOMAIN for a stable URL across restarts
#   3. npm run dev:tunnel  — starts tunnel, updates NEXTAUTH_URL, recreates web
#   4. Register printed URLs in Google Console and @BotFather /setdomain
#
# NGROK_AUTHTOKEN=          # Required for dev:tunnel
# NGROK_STATIC_DOMAIN=      # Hostname only, e.g. your-name.ngrok-free.app (no https://)
# NGROK_LOCAL_PORT=8080     # Port ngrok forwards to (default 8080 — Docker web port)
# NGROK_INSPECTOR_URL=      # Advanced — ngrok local API (default http://127.0.0.1:4040/api/tunnels)
#
# See: .ai/docs/features/local_oauth_setup.md


# ── First admin account (seed) ───────────────────────────────────────────────────
#
# On first boot (empty users collection), Nexus creates one system administrator
# with these credentials. Sign in with ADMIN_SEED_LOGIN + ADMIN_SEED_PASSWORD
# (username/password provider — not email).
#
# Change defaults before any shared or production deploy. Seed runs once only;
# later changes here do NOT update an existing admin password.
#
# Legacy aliases still supported: ADMIN_LOGIN, ADMIN_PASSWORD, ADMIN_EMAIL.
#
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here


# ── Media uploads ──────────────────────────────────────────────────────────────
#
# MEDIA_STORAGE_DRIVER — Where uploaded images/videos are stored.
#
#   local  — Files under public/uploads/ on disk. Default for local dev.
#            Orphan cleanup can scan the filesystem directly.
#
#   s3     — Amazon S3 bucket. REQUIRED when NODE_ENV=production (boot validation
#            fails without it on EC2). Switching drivers requires only env changes —
#            no Puck or API code edits.
#
MEDIA_STORAGE_DRIVER=local

# ── S3 media (required in production) ──────────────────────────────────────────
#
# Uncomment and fill when MEDIA_STORAGE_DRIVER=s3:
#
# S3_MEDIA_BUCKET=my-nexus-media-bucket
#   — Bucket name. IAM policy needs s3:PutObject, s3:DeleteObject, s3:ListBucket.
#
# S3_MEDIA_REGION=eu-central-1
#   — AWS region where the bucket lives.
#
# S3_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media
#   — Optional. Public URL prefix for objects (CloudFront or custom CDN).
#     When unset, URLs use default virtual-hosted S3 style.
#
# AWS credential chain (pick one approach):
#   • EC2 IAM instance role (recommended — no keys in env)
#   • Explicit keys below (dev or non-EC2 hosts)
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
#
# See: .ai/docs/features/media_storage.md
#

# MEDIA_ORPHAN_MIN_AGE_HOURS — Minimum age before an unreferenced upload file
#   can be deleted by orphan cleanup (default 24). Prevents deleting files still
#   being linked in a draft save.
#
MEDIA_ORPHAN_MIN_AGE_HOURS=24


# ── Background jobs (scheduled tasks + orphan cleanup) ─────────────────────────
#
# On AWS EC2 / Docker, Nexus runs background work in-process (no separate cron VM).
# Both intervals are positive numbers in seconds / hours respectively.
#
# SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS — Polls for due reminders, task deadlines,
#   calendar notifications, etc. Set to 15 for responsive dev/prod. Set to 0 to disable
#   in-process scheduler (then use HTTP cron below instead).
#
SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15

# MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS — Scans for upload files no longer referenced
#   in MongoDB and deletes them. Works with local and S3 drivers.
#
MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24

# ── HTTP cron alternative (optional) ───────────────────────────────────────────
#
# Instead of in-process timers, an external crontab can POST to Nexus job routes
# with a Bearer token. Set ONE of these secrets; leave tick intervals at 0 if using
# HTTP-only scheduling.
#
# Endpoints (see .ai/docs/features/scheduled_events.md):
#   POST /api/admin/jobs/scheduled-events-tick
#   POST /api/admin/jobs/media-orphan-cleanup
#
# CRON_SECRET=generate-a-random-secret-here
# NEXUS_CRON_SECRET=generate-a-random-secret-here
# MEDIA_ORPHAN_CLEANUP_CRON_SECRET=   # Legacy alias for orphan cleanup route


# ── Puck editor (optional) ───────────────────────────────────────────────────────
#
# NEXT_PUBLIC_PUCK_SECRET — Optional Bearer token sent from the browser when saving
#   Puck pages via POST /api/puck. Adds an extra client-side guard; server still
#   enforces session auth. Leave unset for normal dev (session auth only).
#
# NEXT_PUBLIC_PUCK_SECRET=


# ── Security & audit (optional overrides) ────────────────────────────────────────
#
# CSP_USE_NONCE — Content-Security-Policy nonce mode.
#   Default: true in production, false in development.
#   Set explicitly to reproduce prod CSP locally and check DevTools console.
#
# CSP_USE_NONCE=true

# SECURITY_SANITIZE_AUDIT_PERSIST — Persist XSS sanitization audit events to MongoDB.
#   Default false. Enable for security review in staging/prod.
#
# SECURITY_SANITIZE_AUDIT_PERSIST=false

# USER_DIRECTORY_AUDIT_PERSIST — Persist user directory change audit log to MongoDB.
#   Default false.
#
# USER_DIRECTORY_AUDIT_PERSIST=false


# ── CI / E2E tests only (not needed for normal dev or deploy) ──────────────────
#
# PLAYWRIGHT_BASE_URL=http://localhost:8080
# PUCK_E2E_EDIT_PATH=/test/edit
# PUCK_E2E_LOGIN=admin
# PUCK_E2E_PASSWORD=your_secure_password_here
