# =============================================================================
# Nexus — environment reference (master catalogue, `.env.example`)
# =============================================================================
#
# THIS FILE IS NOT A DEPLOY PROFILE — it lists every env var Nexus supports.
#
# For a ready-made setup, copy a profile template instead:
#
#   Local dev (bundled MongoDB):  cp .env.vps.example .env.local
#                                 docker compose -f docker-compose.yml -f docker-compose.bundled-db.yml --profile bundled-db up
#   VPS + external MongoDB:       cp .env.vps-external-db.example .env.local
#                                 docker compose up
#   Vercel serverless:            copy .env.vercel.example → Vercel dashboard
#   Vercel + worker:              copy .env.hybrid.example → Vercel + worker host
#
# Use THIS file when:
#   • You need the comment/docs for a specific variable
#   • A profile template omits an optional feature (OAuth, Apple, GCS, etc.)
#   • You are building .env.local from scratch without a profile shortcut
#
# If you do copy this file to .env.local:
#   cp .env.example .env.local
#   # uncomment NEXUS_HOSTING_MODE and fill required values
#
# Never commit `.env.local` — it may contain secrets.
#
# Docs: `.ai/docs/features/hosting_and_deployment.md`
# =============================================================================


# ── Hosting mode ─────────────────────────────────────────────────────────────
# Selects scheduler and storage guardrails. Auto-detected on Vercel when unset.
#
#   vps         — in-process scheduler (Docker / always-on server)
#   serverless  — HTTP cron only (Vercel + CRON_SECRET)
#   hybrid      — serverless web + separate MTProto worker for Telegram auto-create
#
# NEXUS_HOSTING_MODE=vps
#
# Abort boot when hosting env is invalid (default: abort in production only).
# NEXUS_HOSTING_STRICT=true


# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string. Required for every environment.
#
#   Bundled Docker (db service):  mongodb://db:27017/nexus
#   MongoDB on host / Atlas:      see .env.vps-external-db.example
#   Local without Docker:         mongodb://localhost:27017/nexus
MONGODB_URI=mongodb://localhost:27017/nexus


# ── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────
# Random signing key for session cookies. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here

# Public URL of this Nexus site — must match what you type in the browser
# (scheme + host + port). Used for OAuth redirects and absolute links.
#
# Desktop dev:     http://localhost:8080
# Phone on Wi‑Fi:  use your PC's LAN IP, NOT localhost
#                  (on the phone, "localhost" means the phone itself)
#   hostname -I | awk '{print $1}'  →  e.g. http://192.168.1.42:8080
NEXTAUTH_URL=http://localhost:8080

# Optional — browse via LAN IP while NEXTAUTH_URL points at ngrok (OAuth).
# Comma-separated hostnames only (no scheme/port). Dev-only; enables Next.js dev assets.
# NEXUS_DEV_ALLOWED_ORIGINS=192.168.1.42


# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Apple Sign In (optional) ─────────────────────────────────────────────────
# Services ID + JWT client secret — see .ai/docs/features/local_oauth_setup.md
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=


# ── Telegram (optional) ──────────────────────────────────────────────────────
# Bot token from @BotFather. Public username (no @) for the Login Widget.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional: secret sent in X-Telegram-Bot-Api-Secret-Token on webhook requests.
TELEGRAM_WEBHOOK_SECRET=

# Optional: GramJS / Telethon string session for auto-creating project groups.
# Run `npm run worker:telegram` or `docker compose --profile telegram-worker up`.
# Worker requires TELEGRAM_API_ID + TELEGRAM_API_HASH from https://my.telegram.org
# TELEGRAM_OPERATOR_SESSION=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_WORKER_POLL_SECONDS=15

# Mini App URL is ${NEXTAUTH_URL}/telegram — register it in BotFather Web App settings.

# ngrok — local OAuth + Telegram Login Widget (Google rejects LAN IPs; widget needs HTTPS)
# NGROK_AUTHTOKEN=          # https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_STATIC_DOMAIN=      # optional free static domain, e.g. your-name.ngrok-free.app
# Start: npm run dev:tunnel — see .ai/docs/features/local_oauth_setup.md
# ── First admin account (seed) ───────────────────────────────────────────────
# On first boot, Nexus creates one admin user with these credentials.
# Sign in with ADMIN_SEED_LOGIN + ADMIN_SEED_PASSWORD (not email).
# Change ADMIN_SEED_LOGIN and/or ADMIN_SEED_PASSWORD, then restart the app to sync the seed admin credentials.
# Change the password before production. Link Google from /profile/settings for email.
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=your_secure_password_here


# ── Media uploads (where files are stored) ───────────────────────────────────
# Where avatar images, Puck page media, task attachments, etc. are saved.
#
#   local  — files on disk under public/uploads/  (default, fine for local dev)
#   gcs    — Google Cloud Storage bucket           (use on GCP / Vercel)
#   s3     — Amazon S3 bucket                      (use on AWS / production)
MEDIA_STORAGE_DRIVER=local

# Required when MEDIA_STORAGE_DRIVER=gcs:
# GCS_MEDIA_BUCKET=my-nexus-media-bucket
# Optional CDN / public URL prefix for browser-facing media links:
# GCS_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media
# Path to a GCP service-account JSON key (or use Application Default Credentials on GCP):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Required when MEDIA_STORAGE_DRIVER=s3:
# S3_MEDIA_BUCKET=my-nexus-media-bucket
# S3_MEDIA_REGION=eu-central-1
# Optional CDN / public URL prefix for browser-facing media links:
# S3_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media
# Standard AWS credentials (or use an IAM role on EC2/ECS/Lambda):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1


# ── Orphan media cleanup ─────────────────────────────────────────────────────
# When a user replaces an image, the old file is not deleted immediately.
# A cleanup job scans storage and removes files that are no longer referenced
# in MongoDB (user avatars, Puck page content, etc.).
#
# Safety window: never delete files younger than this many hours (protects uploads
# that were saved to disk but not yet written to the database).
MEDIA_ORPHAN_MIN_AGE_HOURS=24

# HOW TO RUN THE CLEANUP JOB — pick ONE approach (see "Background jobs" below):
#
#   A) Vercel — vercel.json already schedules daily cleanup at 03:00 UTC.
#      Set CRON_SECRET (same secret as scheduled-events). Do not set the interval below.
#
#   B) Docker / always-on server — app runs cleanup itself on a timer:
#      MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24
#
#   C) Manual / system crontab — call the HTTP endpoint or CLI on your schedule:
#      GET/POST /api/admin/jobs/media-orphan-cleanup
#      npm run job:media-orphan-cleanup
#
# MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24

# Legacy: separate bearer token only for the cleanup endpoint.
# Prefer CRON_SECRET (one secret for all cron jobs). Admin session also works.
# MEDIA_ORPHAN_CLEANUP_CRON_SECRET=generate-a-random-secret-here


# ── Background jobs (scheduled tasks queue) ──────────────────────────────────
#
# Nexus stores future work in MongoDB (examples: publish a page at a set time,
# send a task reminder, provision a Telegram project group). Something must wake
# up periodically and run whatever is due. That "tick" can be triggered in
# three ways — use exactly ONE for scheduled events:
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ A) Vercel (serverless) — recommended when deploying to Vercel           │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ Set CRON_SECRET. vercel.json calls these routes on a schedule:          │
# │   • every minute → /api/admin/jobs/process-scheduled-events           │
# │   • daily 03:00 UTC → /api/admin/jobs/media-orphan-cleanup            │
# │ Vercel sends: Authorization: Bearer <CRON_SECRET> automatically.      │
# │                                                                         │
# │ DO NOT set SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS on Vercel.            │
# │ DO NOT set MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS if vercel.json cron    │
# │ handles cleanup.                                                        │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ B) Docker / VPS (always-on Node process)                                │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ The app runs an internal timer — no HTTP cron or CRON_SECRET needed.   │
# │                                                                         │
# │ SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15                               │
# │ MEDIA_ORPHAN_CLEANUP_INTERVAL_HOURS=24    (optional)                    │
# │                                                                         │
# │ Leave CRON_SECRET unset unless you also want external cron to call the  │
# │ HTTP endpoints.                                                         │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ C) External crontab (VPS without in-process timer)                      │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ Set NEXUS_CRON_SECRET (or CRON_SECRET) and ping the API from crontab:   │
# │   curl -H "Authorization: Bearer $NEXUS_CRON_SECRET" \                  │
# │     "$NEXTAUTH_URL/api/admin/jobs/process-scheduled-events"             │
# │ Or run: npm run job:process-scheduled-events                            │
# │                                                                         │
# │ Leave SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS unset.                     │
# └─────────────────────────────────────────────────────────────────────────┘

# Shared secret for HTTP cron triggers (Vercel sets this header for you).
# Generate with: openssl rand -base64 32
# CRON_SECRET=generate-a-random-secret-here

# In-process tick for Docker / local always-on server (seconds between runs).
# Disabled when unset or 0. Do not use on Vercel.
# SCHEDULED_EVENTS_TICK_INTERVAL_SECONDS=15

# Same as CRON_SECRET — use when your host is not Vercel but you call the HTTP
# job routes from an external crontab instead of the in-process timer above.
# NEXUS_CRON_SECRET=generate-a-random-secret-here


# ── Security & audit (optional overrides) ────────────────────────────────────
# Content Security Policy: stricter script tags via per-request nonces.
# Default: on in production, off in development.
# CSP_USE_NONCE=true

# Puck editor: save sanitization audit rows to MongoDB (default: on).
# Set false to log to console only.
# SECURITY_SANITIZE_AUDIT_PERSIST=false

# Admin user directory: persist edit audit rows to MongoDB (default: on).
# USER_DIRECTORY_AUDIT_PERSIST=false